rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function autenticado() {
      return request.auth != null;
    }

    function donoDaEmpresa(empresaId) {
      return autenticado()
          && get(/databases/$(database)/documents/empresas/$(empresaId)).data.uidDono
              == request.auth.uid
          && get(/databases/$(database)/documents/empresas/$(empresaId)).data.status
              == 'ativo';
    }

    function membroDaEmpresa(empresaId) {
      return autenticado()
          && request.auth.token.email != null
          && get(/databases/$(database)/documents/empresas/$(empresaId)/membros/$(request.auth.token.email)).data.status == 'ativo'
          && get(/databases/$(database)/documents/empresas/$(empresaId)/membros/$(request.auth.token.email)).data.uid == request.auth.uid;
    }

    function empresaAtiva(empresaId) {
      return donoDaEmpresa(empresaId) || membroDaEmpresa(empresaId);
    }

    function podeGerenciarEmpresa(empresaId) {
      return donoDaEmpresa(empresaId)
          || (membroDaEmpresa(empresaId)
              && get(/databases/$(database)/documents/empresas/$(empresaId)/membros/$(request.auth.token.email)).data.papel == 'administrador');
    }

    function pertenceAoUsuario() {
      return autenticado() && empresaAtiva(resource.data.empresaId);
    }

    function novaEmpresaDoUsuario() {
      return autenticado() && empresaAtiva(request.resource.data.empresaId);
    }

    function mantemEmpresaDoUsuario() {
      return autenticado()
          && empresaAtiva(resource.data.empresaId)
          && request.resource.data.empresaId == resource.data.empresaId;
    }

    function aparelhoPertenceAoUsuario(aparelhoId) {
      return empresaAtiva(get(/databases/$(database)/documents/celulares_usados/$(aparelhoId)).data.empresaId)
          && get(/databases/$(database)/documents/celulares_usados/$(aparelhoId)).data.empresaId
              != null;
    }

    function configuracaoValida(configuracaoId) {
      return (configuracaoId == 'contador_os'
              && request.resource.data.keys().hasOnly(['ultimo_numero'])
              && request.resource.data.ultimo_numero is int)
          || (configuracaoId == 'geral'
              && request.resource.data.keys().hasOnly([
                'nomeEmpresa',
                'logoUrl',
                'telefone',
                'endereco',
                'informacoesComerciais',
                'metaMensal',
                'maoDeObraPadrao',
                'valoresServico',
                'tema',
                'atualizadoEm'
              ])
              && request.resource.data.nomeEmpresa is string
              && request.resource.data.logoUrl is string
              && request.resource.data.telefone is string
              && request.resource.data.endereco is string
              && request.resource.data.informacoesComerciais is string
              && request.resource.data.metaMensal is number
              && request.resource.data.metaMensal >= 0
              && request.resource.data.maoDeObraPadrao is number
              && request.resource.data.maoDeObraPadrao >= 0
              && request.resource.data.valoresServico is map
              && request.resource.data.valoresServico.keys().hasOnly([
                'trocaTela',
                'trocaConector'
              ])
              && request.resource.data.valoresServico.trocaTela is number
              && request.resource.data.valoresServico.trocaTela >= 0
              && request.resource.data.valoresServico.trocaConector is number
              && request.resource.data.valoresServico.trocaConector >= 0
              && request.resource.data.tema in ['claro', 'escuro']);
    }

    // Cada conta cria somente seu próprio cadastro, inicialmente pendente.
    // Alterações de plano e de assinatura devem ser feitas pelo Admin SDK.
    match /empresas/{empresaId} {
      allow create: if autenticado()
          && empresaId == request.auth.uid
          && request.resource.data.uidDono == request.auth.uid
          && request.resource.data.usuarioId == request.auth.uid
          && request.resource.data.status == 'pendente'
          && request.resource.data.statusAssinatura == 'pendente'
          && request.resource.data.plano == 'mensal'
          && request.resource.data.valorMensal == 19.90;
      allow read: if autenticado() && (resource.data.uidDono == request.auth.uid || membroDaEmpresa(empresaId));
      allow update, delete: if false;

      match /configuracoes/{configuracaoId} {
        allow read: if empresaAtiva(empresaId);
        allow create, update: if podeGerenciarEmpresa(empresaId)
            && configuracaoValida(configuracaoId);
        allow delete: if false;
      }

      match /membros/{email} {
        allow get, list: if donoDaEmpresa(empresaId)
            || (autenticado() && resource.data.email == request.auth.token.email);
        allow create: if donoDaEmpresa(empresaId)
            && request.resource.data.keys().hasOnly(['email', 'papel', 'status', 'uid', 'criadoEm'])
            && request.resource.data.email == email
            && request.resource.data.papel in ['administrador', 'gerente', 'tecnico', 'caixa']
            && request.resource.data.status == 'convidado'
            && request.resource.data.uid == null;
        allow update: if donoDaEmpresa(empresaId)
            || (autenticado()
                && resource.data.email == request.auth.token.email
                && resource.data.status == 'convidado'
                && request.resource.data.email == resource.data.email
                && request.resource.data.papel == resource.data.papel
                && request.resource.data.status == 'ativo'
                && request.resource.data.uid == request.auth.uid
                && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'uid', 'ativadoEm']));
        allow delete: if donoDaEmpresa(empresaId);
      }
    }

    match /clientes/{documentoId} {
      allow read: if pertenceAoUsuario();
      allow create: if novaEmpresaDoUsuario();
      allow update: if mantemEmpresaDoUsuario();
      allow delete: if pertenceAoUsuario();
    }

    match /ordens_servico/{documentoId} {
      allow read: if pertenceAoUsuario();
      allow create: if novaEmpresaDoUsuario();
      allow update: if mantemEmpresaDoUsuario();
      allow delete: if pertenceAoUsuario();
    }

    match /estoque/{documentoId} {
      allow read: if pertenceAoUsuario();
      allow create: if novaEmpresaDoUsuario();
      allow update: if mantemEmpresaDoUsuario();
      allow delete: if pertenceAoUsuario();
    }

    match /financeiro/{documentoId} {
      allow read: if pertenceAoUsuario();
      allow create: if novaEmpresaDoUsuario();
      allow update: if mantemEmpresaDoUsuario();
      allow delete: if pertenceAoUsuario();
    }

    match /garantias/{documentoId} {
      allow read: if pertenceAoUsuario();
      allow create: if novaEmpresaDoUsuario();
      allow update: if mantemEmpresaDoUsuario();
      allow delete: if pertenceAoUsuario();
    }

    match /tecnicos/{documentoId} {
      allow read: if pertenceAoUsuario();
      allow create: if novaEmpresaDoUsuario();
      allow update: if mantemEmpresaDoUsuario();
      allow delete: if pertenceAoUsuario();
    }

    match /celulares_usados/{aparelhoId} {
      allow read: if pertenceAoUsuario();
      allow create: if novaEmpresaDoUsuario();
      allow update: if mantemEmpresaDoUsuario();
      allow delete: if pertenceAoUsuario();

      // Histórico técnico é adicionável, mas não pode ser reescrito ou apagado.
      match /processo/{processoId} {
        allow read: if aparelhoPertenceAoUsuario(aparelhoId);
        allow create: if aparelhoPertenceAoUsuario(aparelhoId)
            && request.resource.data.empresaId == get(/databases/$(database)/documents/celulares_usados/$(aparelhoId)).data.empresaId;
        allow update, delete: if false;
      }

      // Termo assinado é uma evidência imutável no MVP.
      match /termo_compra/{termoId} {
        allow read: if aparelhoPertenceAoUsuario(aparelhoId);
        allow create: if aparelhoPertenceAoUsuario(aparelhoId)
            && request.resource.data.empresaId == get(/databases/$(database)/documents/celulares_usados/$(aparelhoId)).data.empresaId;
        allow update, delete: if false;
      }
    }
  }
}
